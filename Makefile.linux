# Prometheus99 on Linux (Raspberry Pi OS Lite / Debian / Ubuntu, x86-64 or ARM).
#
# STATUS: built and tested on Ubuntu 24.04 under WSL2 (see
# docs/LINUX_VALIDATION.md). Not run on a Raspberry Pi or on a real
# framebuffer. Record new results in docs/LINUX_VALIDATION.md.
#
#   sudo apt install build-essential pkg-config libmodbus-dev git
#   git clone --depth 1 --branch v9.2.2 https://github.com/lvgl/lvgl.git third_party/lvgl
#   make -f Makefile.linux test        # core tests (mock PLC, fake clock)
#   make -f Makefile.linux e2e         # runtime + system libmodbus vs POSIX fake PLC
#   make -f Makefile.linux ui-host     # real LVGL, headless render + scenario
#   make -f Makefile.linux hmi         # the fbdev/evdev executable
#   make -f Makefile.linux hmi-run-sim # hmi on /dev/fb0 against the fake PLC
#
# libmodbus: the SYSTEM library (apt libmodbus-dev, any 3.1.x) is linked
# dynamically (LGPL-2.1+). Record the version used in docs/LINUX_VALIDATION.md.

# Presentation layer: one file per screen plus the shared header (see src/ui/ui_priv.h).
include sources.mk
CC ?= gcc
BUILD = build-linux
LVGL = third_party/lvgl

# Default: the development build (glibc, dynamic, -O2, system libmodbus).
# STATIC=1 selects the small build for a device (see docs/OPTIMIZATION_ROADMAP.md, phase 1):
#   make -f Makefile.linux STATIC=1 CC=musl-gcc BUILD=build-musl hmi-bench
# It is linked statically against musl, optimised for size with link-time optimisation, without unwind tables,
# and libmodbus is compiled from third_party/libmodbus (only the TCP part). Static PIE keeps address randomisation.
ifeq ($(STATIC),1)
CFLAGS = -std=gnu99 -Os -flto -Wall -Wextra -Wpedantic -ffunction-sections -fdata-sections \
         -fno-unwind-tables -fno-asynchronous-unwind-tables -fstack-protector-strong -D_FORTIFY_SOURCE=2 -fPIE
LDFLAGS = -Wl,--gc-sections -Wl,-z,relro,-z,now -Wl,--build-id=none -static-pie
MB_CFLAGS = -DHAVE_CONFIG_H -Ithird_party/libmodbus_cfg -Ithird_party/libmodbus/src
MB_OBJS = $(BUILD)/libmodbus/modbus.o $(BUILD)/libmodbus/modbus-tcp.o $(BUILD)/libmodbus/modbus-data.o
MB_LIBS = $(MB_OBJS)
$(MB_OBJS): $(BUILD)/libmodbus/%.o: third_party/libmodbus/src/%.c
	@mkdir -p $(dir $@)
	$(CC) -std=gnu99 -Os -flto -ffunction-sections -fdata-sections -fno-unwind-tables -fno-asynchronous-unwind-tables \
	  -fPIE $(MB_CFLAGS) -c $< -o $@
else
CFLAGS = -std=gnu99 -O2 -Wall -Wextra -Wpedantic -ffunction-sections -fdata-sections \
         -fstack-protector-strong -D_FORTIFY_SOURCE=2 -fPIE
LDFLAGS = -Wl,--gc-sections -Wl,-z,relro,-z,now -pie
MB_CFLAGS = $(shell pkg-config --cflags libmodbus)
MB_LIBS = $(shell pkg-config --libs libmodbus)
MB_OBJS =
endif
# LITE=1 builds the lite profile (docs/OPTIMIZATION_ROADMAP.md, phase 5): no trend screen, no CONFIG view, at most
# 32 tags, no chart widget. Use another BUILD directory for it, for example BUILD=build-musl-lite.
ifeq ($(LITE),1)
CFLAGS += -DP99_LITE=1
UI_SRC := $(filter-out src/ui/ui_trends.c src/ui/ui_config.c,$(UI_SRC))
endif
# SAN=address (AddressSanitizer and UBSan) or SAN=thread (ThreadSanitizer) builds the test programs instrumented:
#   make -f Makefile.linux SAN=address BUILD=build-asan test
ifneq ($(SAN),)
, := ,
SAN_FLAGS = $(if $(filter address,$(SAN)),-fsanitize=address$(,)undefined,-fsanitize=$(SAN)) -fno-omit-frame-pointer -g -O1
CFLAGS += $(SAN_FLAGS)
LDFLAGS += $(SAN_FLAGS)
endif
# -fwrapv: LVGL's chart multiplies a "no value" point (INT32_MAX) by the height before it tests for it; UBSan reports the overflow
# (third_party/lvgl/src/widgets/chart/lv_chart.c, line 847). With -fwrapv the result is defined and is not used for such a point.
LVGL_CFLAGS = -fwrapv -DLV_CONF_INCLUDE_SIMPLE -Iconfig -I$(LVGL)
LVGL_LINUX = -DP99_LINUX_TARGET

HMI_CORE = $(HMI_CORE_COMMON) src/hmi/hmi_platform_posix.c
FAKE_PLC = tests/hmi/fake_modbus_server_posix.c
WRAP = -Wl,--wrap=malloc -Wl,--wrap=calloc -Wl,--wrap=realloc -Wl,--wrap=free

LVGL_SRCS = $(shell find $(LVGL)/src -name '*.c')
# Two object sets: the headless harness must not need fbdev/evdev; the HMI does.
LVGL_OBJS_H = $(patsubst $(LVGL)/%.c,$(BUILD)/lvgl-headless/%.o,$(LVGL_SRCS))
LVGL_OBJS_L = $(patsubst $(LVGL)/%.c,$(BUILD)/lvgl-linux/%.o,$(LVGL_SRCS))

$(BUILD)/lvgl-headless/%.o: $(LVGL)/%.c config/lv_conf.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(LVGL_CFLAGS) -c $< -o $@

$(BUILD)/lvgl-linux/%.o: $(LVGL)/%.c config/lv_conf.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(LVGL_CFLAGS) $(LVGL_LINUX) -c $< -o $@

HMI_TESTS = decode tags comms link_health writes alarm config runtime watchdog authz cli platform mac cfgsec store auditfmt trend cfgedit boot
HMI_TEST_BINS = $(patsubst %,$(BUILD)/hmi_tests/test_%,$(HMI_TESTS))

# One program per module; each links the shared fixtures in test_support.c.
$(BUILD)/hmi_tests/test_%: tests/hmi/test_%.c tests/hmi/test_support.c tests/hmi/test_support.h $(HMI_CORE)
	@mkdir -p $(BUILD)/hmi_tests
	$(CC) $(CFLAGS) -Isrc/hmi $< tests/hmi/test_support.c $(HMI_CORE) -o $@ -lm -lpthread

$(BUILD)/test_e2e: tests/hmi/test_modbus_e2e.c $(FAKE_PLC) src/hmi/plc_libmodbus.c $(HMI_CORE) $(MB_OBJS)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $(MB_CFLAGS) -Isrc/hmi tests/hmi/test_modbus_e2e.c $(FAKE_PLC) src/hmi/plc_libmodbus.c \
	  $(HMI_CORE) -o $@ $(MB_LIBS) -lm -lpthread

$(BUILD)/ui_headless: tests/hmi/ui_headless.c tests/hmi/alloc_count.c $(FAKE_PLC) $(UI_SRC) src/ui/hmi_view.c \
                      src/hmi/plc_libmodbus.c $(HMI_CORE) $(LVGL_OBJS_H) $(MB_OBJS)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $(LVGL_CFLAGS) $(MB_CFLAGS) tests/hmi/ui_headless.c tests/hmi/alloc_count.c $(FAKE_PLC) \
	  $(UI_SRC) src/ui/hmi_view.c src/hmi/plc_libmodbus.c $(HMI_CORE) $(LVGL_OBJS_H) -o $@ \
	  $(LDFLAGS) $(MB_LIBS) -lm -lpthread $(WRAP)

# The device program also contains the root helper: started under the name p99_cfg (a link to this file) it applies a
# configuration request (P99_MULTICALL), so the device needs one file instead of two.
$(BUILD)/prometheus99: src/app/main_linux.c src/app/display_fbdev.c src/app/p99_cfg.c $(UI_SRC) src/ui/hmi_view.c src/hmi/plc_libmodbus.c $(HMI_CORE) $(LVGL_OBJS_L) $(MB_OBJS)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -DP99_MULTICALL $(LVGL_CFLAGS) $(LVGL_LINUX) $(MB_CFLAGS) src/app/main_linux.c src/app/display_fbdev.c src/app/p99_cfg.c $(UI_SRC) src/ui/hmi_view.c \
	  src/hmi/plc_libmodbus.c $(HMI_CORE) $(LVGL_OBJS_L) -o $@ $(LDFLAGS) $(MB_LIBS) -lm -lpthread

# Test build: also accepts --unsigned-config (no signature check). NEVER deploy it.
$(BUILD)/prometheus99-sim: src/app/main_linux.c src/app/display_fbdev.c $(UI_SRC) src/ui/hmi_view.c src/hmi/plc_libmodbus.c $(HMI_CORE) $(LVGL_OBJS_L) $(MB_OBJS)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -DHMI_TEST_ROLE=1 $(LVGL_CFLAGS) $(LVGL_LINUX) $(MB_CFLAGS) src/app/main_linux.c src/app/display_fbdev.c $(UI_SRC) \
	  src/ui/hmi_view.c src/hmi/plc_libmodbus.c $(HMI_CORE) $(LVGL_OBJS_L) -o $@ $(LDFLAGS) $(MB_LIBS) -lm -lpthread

# Configuration signing tool (see src/app/p99_sign.c).
$(BUILD)/p99_sign: src/app/p99_sign.c $(HMI_CORE)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) src/app/p99_sign.c $(HMI_CORE) -o $@ $(LDFLAGS) -lm -lpthread

# Root helper that applies a configuration change requested from the screen (see src/app/p99_cfg.c).
$(BUILD)/p99_cfg: src/app/p99_cfg.c $(HMI_CORE)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) src/app/p99_cfg.c $(HMI_CORE) -o $@ $(LDFLAGS) -lm -lpthread

$(BUILD)/test_view: tests/hmi/test_hmi_view.c src/ui/hmi_view.c $(HMI_CORE)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -Isrc/hmi tests/hmi/test_hmi_view.c src/ui/hmi_view.c $(HMI_CORE) -o $@ -lm -lpthread

$(BUILD)/config_golden: tests/hmi/config_golden.c src/hmi/hmi_config.c src/hmi/hmi_config_write.c src/hmi/hmi_tags.c src/hmi/hmi_decode.c \
                        src/hmi/hmi_platform_posix.c
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -Isrc/hmi tests/hmi/config_golden.c src/hmi/hmi_config.c src/hmi/hmi_config_write.c src/hmi/hmi_tags.c \
	  src/hmi/hmi_decode.c src/hmi/hmi_platform_posix.c -o $@ -lm -lpthread

# Every accept/reject verdict, error text and parsed field must match the
# golden file generated by the pre-table parser.
test-config-golden: $(BUILD)/config_golden
	./$(BUILD)/config_golden > $(BUILD)/config_golden.out
	diff -u tests/hmi/config_golden.txt $(BUILD)/config_golden.out && echo "config golden: identical"

test: $(HMI_TEST_BINS)
	sh tests/hmi/run_core_tests.sh $(BUILD)/hmi_tests $(HMI_TESTS)

test-view: $(BUILD)/test_view
	./$(BUILD)/test_view

e2e: $(BUILD)/test_e2e
	./$(BUILD)/test_e2e

# The screenshots of the scenario are checked against the 16-colour palette (needs python3).
ui-shots: ui-host
	python3 tests/hmi/shot_tool.py check $(BUILD)/shot_*.ppm

ui-host: $(BUILD)/ui_headless
	rm -f $(BUILD)/shot_*.ppm
	./$(BUILD)/ui_headless $(BUILD)/shot $(BUILD)/ui_audit.log

hmi: $(BUILD)/prometheus99 $(BUILD)/p99_sign $(BUILD)/p99_cfg

hmi-sim: $(BUILD)/prometheus99-sim

# Needs a framebuffer (/dev/fb0) and evdev touch/mouse. Not a test. Uses the simulation build, which also accepts
# --unsigned-config (the claimed --role works in both builds).
hmi-run-sim: $(BUILD)/prometheus99-sim
	./$(BUILD)/prometheus99-sim --config config/hmi.example.json --audit $(BUILD)/audit.log --alarms $(BUILD)/alarms.bin --role operator

test-all: check-tagdb-access test test-notify test-view test-config-golden e2e ui-host ui-shots liveness cli-exec config-exec cfgedit-exec

clean:
	rm -rf $(BUILD)

.PHONY: test test-view test-config-golden e2e ui-host ui-shots hmi hmi-sim hmi-run-sim test-all clean

# Outside hmi_tags.c (and the white-box core test) nothing may read or write
# the tag table's members directly; use the hmi_tagdb_* accessors.
TAGDB_GUARD_FILES = $(filter-out src/hmi/hmi_tags.c,$(wildcard src/hmi/*.c src/hmi/*.h src/ui/*.c src/ui/*.h src/app/*.c)) \
                    tests/hmi/ui_headless.c tests/hmi/test_modbus_e2e.c tests/hmi/test_hmi_view.c
check-tagdb-access:
	@if grep -nE '\bdb(\.|->)(cfg|val|groups|order|n_tags|n_groups|global_version|lock|ready)\b' $(TAGDB_GUARD_FILES); then \
	  echo "check-tagdb-access: FAIL (use hmi_tagdb_* accessors)"; exit 1; \
	else echo "check-tagdb-access: ok"; fi

.PHONY: check-tagdb-access

# ---- liveness supervision (sd_notify heartbeat) ----
$(BUILD)/test_notify: tests/hmi/test_notify_posix.c tests/hmi/test_support.c tests/hmi/test_support.h $(HMI_CORE)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -Isrc/hmi tests/hmi/test_notify_posix.c tests/hmi/test_support.c $(HMI_CORE) -o $@ -lm -lpthread

test-notify: $(BUILD)/test_notify
	./$(BUILD)/test_notify

$(BUILD)/notify_listener: tests/hmi/notify_listener.c
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $< -o $@

# Runs the real executable under a fake systemd: READY, WATCHDOG cadence,
# SIGSTOP / SIGCONT / SIGKILL. No display, loopback config, no PLC.
liveness: $(BUILD)/prometheus99 $(BUILD)/p99_sign $(BUILD)/notify_listener $(BUILD)/hang_server
	bash tests/hmi/liveness_e2e.sh $(BUILD) config/hmi.example.json

.PHONY: test-notify liveness

$(BUILD)/hang_server: tests/hmi/hang_server.c
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $< -o $@

# Real executables: invalid flags exit 2; both builds accept --role (a claimed role, not authenticated); a missing
# framebuffer, or a device that is not one, exits 2; the simulation build also accepts --unsigned-config.
cli-exec: $(BUILD)/prometheus99 $(BUILD)/prometheus99-sim $(BUILD)/p99_sign
	bash tests/hmi/cli_exec_test.sh $(BUILD) config/hmi.example.json

# Real executables and the signing tool: signed configuration accepted,
# every kind of tampering ends in safe mode, rollback, allow-list, file modes.
config-exec: $(BUILD)/prometheus99 $(BUILD)/p99_sign
	bash tests/hmi/config_exec_test.sh $(BUILD) config/hmi.example.json

# The root helper p99_cfg against real files: applied, tampered configuration, wrong key,
# stale serial, forbidden keys, allow-list, symlink, owner, size, missing END. Run as root.
cfgedit-exec: $(BUILD)/p99_cfg $(BUILD)/p99_sign
	bash tests/hmi/cfgedit_exec_test.sh $(BUILD) config/hmi.example.json

.PHONY: cli-exec config-exec cfgedit-exec

# The runtime is killed with SIGKILL at random moments while it writes the
# audit file, the alarm journal and the alarm state; the files must be valid
# every time and every PLC write must have its SENT record (see the script).
$(BUILD)/killloop_child: tests/hmi/killloop_child.c tests/hmi/test_support.c tests/hmi/test_support.h $(HMI_CORE)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -Isrc/hmi tests/hmi/killloop_child.c tests/hmi/test_support.c $(HMI_CORE) -o $@ -lm -lpthread

$(BUILD)/killloop_verify: tests/hmi/killloop_verify.c tests/hmi/test_support.c tests/hmi/test_support.h $(HMI_CORE)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -Isrc/hmi tests/hmi/killloop_verify.c tests/hmi/test_support.c $(HMI_CORE) -o $@ -lm -lpthread

# KILL_ROUNDS=<n> sets the number of rounds (default 30)
killloop: $(BUILD)/killloop_child $(BUILD)/killloop_verify
	bash tests/hmi/killloop_selftest.sh $(BUILD)
	bash tests/hmi/killloop_test.sh $(BUILD) $(or $(KILL_ROUNDS),30)

.PHONY: killloop

# ---- measurement (see bench/README.md) ----
# The real executable with a regular file as its framebuffer (src/app/display_file.c),
# the simulation role handling and a linker map, so PSS, threads and sizes can be measured without a display.
$(BUILD)/prometheus99-bench: src/app/main_linux.c src/app/display_file.c $(UI_SRC) src/ui/hmi_view.c src/hmi/plc_libmodbus.c $(HMI_CORE) $(LVGL_OBJS_L) $(MB_OBJS)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -DHMI_TEST_ROLE=1 $(LVGL_CFLAGS) $(LVGL_LINUX) $(MB_CFLAGS) src/app/main_linux.c src/app/display_file.c $(UI_SRC) \
	  src/ui/hmi_view.c src/hmi/plc_libmodbus.c $(HMI_CORE) $(LVGL_OBJS_L) -o $@ $(LDFLAGS) -Wl,-Map=$(BUILD)/prometheus99-bench.map \
	  $(MB_LIBS) -lm -lpthread

$(BUILD)/fake_plc: tests/hmi/fake_plc_main.c $(FAKE_PLC) tests/hmi/fake_modbus_server.h
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -Itests/hmi tests/hmi/fake_plc_main.c $(FAKE_PLC) -o $@ -lm -lpthread

hmi-bench: $(BUILD)/prometheus99-bench $(BUILD)/fake_plc $(BUILD)/p99_sign

.PHONY: hmi-bench

# ---- desktop window build (development and demonstration, not the device) ----
# The same program in an SDL2 window (sudo apt install libsdl2-dev), for a machine with a window system such as WSLg.
#   make -f Makefile.linux BUILD=build-sdl hmi-sdl
$(BUILD)/prometheus99-sdl: src/app/main_linux.c src/app/display_sdl.c $(UI_SRC) src/ui/hmi_view.c src/hmi/plc_libmodbus.c $(HMI_CORE) $(LVGL_OBJS_L) $(MB_OBJS)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $(LVGL_CFLAGS) $(LVGL_LINUX) $(MB_CFLAGS) $(shell sdl2-config --cflags) src/app/main_linux.c src/app/display_sdl.c $(UI_SRC) \
	  src/ui/hmi_view.c src/hmi/plc_libmodbus.c $(HMI_CORE) $(LVGL_OBJS_L) -o $@ $(LDFLAGS) $(MB_LIBS) $(shell sdl2-config --libs) -lm -lpthread

hmi-sdl: $(BUILD)/prometheus99-sdl $(BUILD)/fake_plc $(BUILD)/p99_sign

.PHONY: hmi-sdl
