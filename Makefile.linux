# Prometheus99 on Linux (Raspberry Pi OS Lite / Debian / Ubuntu, x86-64 or ARM).
#
# STATUS: built and tested on Ubuntu 24.04 under WSL2 (see
# docs/LINUX_VALIDATION.md). Not run on a Raspberry Pi or on a real
# framebuffer. Record new results in docs/LINUX_VALIDATION.md.
#
#   sudo apt install build-essential pkg-config libmodbus-dev git
#   git clone --depth 1 --branch v9.2.2 https://github.com/lvgl/lvgl.git third_party/lvgl
#   make -f Makefile.linux test        # core tests (mock PLC, fake clock)
#   make -f Makefile.linux e2e         # runtime + system libmodbus vs POSIX fake PLC
#   make -f Makefile.linux ui-host     # real LVGL, headless render + scenario
#   make -f Makefile.linux hmi         # the fbdev/evdev executable
#   make -f Makefile.linux hmi-run-sim # hmi on /dev/fb0 against the fake PLC
#
# libmodbus: the SYSTEM library (apt libmodbus-dev, any 3.1.x) is linked
# dynamically (LGPL-2.1+). Record the version used in docs/LINUX_VALIDATION.md.

CC ?= gcc
BUILD = build-linux
LVGL = third_party/lvgl

CFLAGS = -std=gnu99 -O2 -Wall -Wextra -Wpedantic -ffunction-sections -fdata-sections \
         -fstack-protector-strong -D_FORTIFY_SOURCE=2 -fPIE
LDFLAGS = -Wl,--gc-sections -Wl,-z,relro,-z,now -pie
LVGL_CFLAGS = -DLV_CONF_INCLUDE_SIMPLE -Iconfig -I$(LVGL)
LVGL_LINUX = -DP99_LINUX_TARGET
MB_CFLAGS = $(shell pkg-config --cflags libmodbus)
MB_LIBS = $(shell pkg-config --libs libmodbus)

HMI_CORE = src/hmi/hmi_decode.c src/hmi/hmi_tags.c src/hmi/hmi_comms.c src/hmi/hmi_writes.c src/hmi/hmi_alarm.c \
           src/hmi/hmi_config.c src/hmi/hmi_runtime.c src/hmi/hmi_watchdog.c src/hmi/hmi_authz.c src/hmi/hmi_cli.c src/hmi/hmi_platform_posix.c
FAKE_PLC = tests/hmi/fake_modbus_server_posix.c
WRAP = -Wl,--wrap=malloc -Wl,--wrap=calloc -Wl,--wrap=realloc -Wl,--wrap=free

LVGL_SRCS = $(shell find $(LVGL)/src -name '*.c')
# Two object sets: the headless harness must not need fbdev/evdev; the HMI does.
LVGL_OBJS_H = $(patsubst $(LVGL)/%.c,$(BUILD)/lvgl-headless/%.o,$(LVGL_SRCS))
LVGL_OBJS_L = $(patsubst $(LVGL)/%.c,$(BUILD)/lvgl-linux/%.o,$(LVGL_SRCS))

$(BUILD)/lvgl-headless/%.o: $(LVGL)/%.c config/lv_conf.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(LVGL_CFLAGS) -c $< -o $@

$(BUILD)/lvgl-linux/%.o: $(LVGL)/%.c config/lv_conf.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(LVGL_CFLAGS) $(LVGL_LINUX) -c $< -o $@

HMI_TESTS = decode tags comms link_health writes alarm config runtime watchdog authz cli
HMI_TEST_BINS = $(patsubst %,$(BUILD)/hmi_tests/test_%,$(HMI_TESTS))

# One program per module; each links the shared fixtures in test_support.c.
$(BUILD)/hmi_tests/test_%: tests/hmi/test_%.c tests/hmi/test_support.c tests/hmi/test_support.h $(HMI_CORE)
	@mkdir -p $(BUILD)/hmi_tests
	$(CC) $(CFLAGS) -Isrc/hmi $< tests/hmi/test_support.c $(HMI_CORE) -o $@ -lm -lpthread

$(BUILD)/test_e2e: tests/hmi/test_modbus_e2e.c $(FAKE_PLC) src/hmi/plc_libmodbus.c $(HMI_CORE)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $(MB_CFLAGS) -Isrc/hmi tests/hmi/test_modbus_e2e.c $(FAKE_PLC) src/hmi/plc_libmodbus.c \
	  $(HMI_CORE) -o $@ $(MB_LIBS) -lm -lpthread

$(BUILD)/ui_headless: tests/hmi/ui_headless.c tests/hmi/alloc_count.c $(FAKE_PLC) src/ui/hmi_ui.c src/ui/hmi_view.c \
                      src/hmi/plc_libmodbus.c $(HMI_CORE) $(LVGL_OBJS_H)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $(LVGL_CFLAGS) $(MB_CFLAGS) tests/hmi/ui_headless.c tests/hmi/alloc_count.c $(FAKE_PLC) \
	  src/ui/hmi_ui.c src/ui/hmi_view.c src/hmi/plc_libmodbus.c $(HMI_CORE) $(LVGL_OBJS_H) -o $@ \
	  $(LDFLAGS) $(MB_LIBS) -lm -lpthread $(WRAP)

$(BUILD)/prometheus99: src/app/main_linux.c src/ui/hmi_ui.c src/ui/hmi_view.c src/hmi/plc_libmodbus.c $(HMI_CORE) $(LVGL_OBJS_L)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $(LVGL_CFLAGS) $(LVGL_LINUX) $(MB_CFLAGS) src/app/main_linux.c src/ui/hmi_ui.c src/ui/hmi_view.c \
	  src/hmi/plc_libmodbus.c $(HMI_CORE) $(LVGL_OBJS_L) -o $@ $(LDFLAGS) $(MB_LIBS) -lm -lpthread

$(BUILD)/test_view: tests/hmi/test_hmi_view.c src/ui/hmi_view.c $(HMI_CORE)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -Isrc/hmi tests/hmi/test_hmi_view.c src/ui/hmi_view.c $(HMI_CORE) -o $@ -lm -lpthread

$(BUILD)/config_golden: tests/hmi/config_golden.c src/hmi/hmi_config.c src/hmi/hmi_tags.c src/hmi/hmi_decode.c \
                        src/hmi/hmi_platform_posix.c
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -Isrc/hmi tests/hmi/config_golden.c src/hmi/hmi_config.c src/hmi/hmi_tags.c \
	  src/hmi/hmi_decode.c src/hmi/hmi_platform_posix.c -o $@ -lm -lpthread

# Every accept/reject verdict, error text and parsed field must match the
# golden file generated by the pre-table parser.
test-config-golden: $(BUILD)/config_golden
	./$(BUILD)/config_golden > $(BUILD)/config_golden.out
	diff -u tests/hmi/config_golden.txt $(BUILD)/config_golden.out && echo "config golden: identical"

test: $(HMI_TEST_BINS)
	sh tests/hmi/run_core_tests.sh $(BUILD)/hmi_tests $(HMI_TESTS)

test-view: $(BUILD)/test_view
	./$(BUILD)/test_view

e2e: $(BUILD)/test_e2e
	./$(BUILD)/test_e2e

ui-host: $(BUILD)/ui_headless
	./$(BUILD)/ui_headless $(BUILD)/shot $(BUILD)/ui_audit.log

hmi: $(BUILD)/prometheus99

# Needs a framebuffer (/dev/fb0) and evdev touch/mouse. Not a test.
hmi-run-sim: $(BUILD)/prometheus99
	./$(BUILD)/prometheus99 --config config/hmi.example.json --audit $(BUILD)/audit.log --alarms $(BUILD)/alarms.bin --role operator

test-all: check-tagdb-access test test-notify test-view test-config-golden e2e ui-host liveness cli-exec

clean:
	rm -rf $(BUILD)

.PHONY: test test-view test-config-golden e2e ui-host hmi hmi-run-sim test-all clean

# Outside hmi_tags.c (and the white-box core test) nothing may read or write
# the tag table's members directly; use the hmi_tagdb_* accessors.
TAGDB_GUARD_FILES = $(filter-out src/hmi/hmi_tags.c,$(wildcard src/hmi/*.c src/hmi/*.h src/ui/*.c src/ui/*.h src/app/*.c)) \
                    tests/hmi/ui_headless.c tests/hmi/test_modbus_e2e.c tests/hmi/test_hmi_view.c
check-tagdb-access:
	@if grep -nE '\bdb(\.|->)(cfg|val|groups|order|n_tags|n_groups|global_version|lock|ready)\b' $(TAGDB_GUARD_FILES); then \
	  echo "check-tagdb-access: FAIL (use hmi_tagdb_* accessors)"; exit 1; \
	else echo "check-tagdb-access: ok"; fi

.PHONY: check-tagdb-access

# ---- liveness supervision (sd_notify heartbeat) ----
$(BUILD)/test_notify: tests/hmi/test_notify_posix.c tests/hmi/test_support.c tests/hmi/test_support.h $(HMI_CORE)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -Isrc/hmi tests/hmi/test_notify_posix.c tests/hmi/test_support.c $(HMI_CORE) -o $@ -lm -lpthread

test-notify: $(BUILD)/test_notify
	./$(BUILD)/test_notify

$(BUILD)/notify_listener: tests/hmi/notify_listener.c
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $< -o $@

# Runs the real executable under a fake systemd: READY, WATCHDOG cadence,
# SIGSTOP / SIGCONT / SIGKILL. No display, loopback config, no PLC.
liveness: $(BUILD)/prometheus99 $(BUILD)/notify_listener $(BUILD)/hang_server
	bash tests/hmi/liveness_e2e.sh $(BUILD) config/hmi.example.json

.PHONY: test-notify liveness

$(BUILD)/hang_server: tests/hmi/hang_server.c
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $< -o $@

# Real executable: invalid role / flags exit 2, valid roles start, default is viewer.
cli-exec: $(BUILD)/prometheus99
	bash tests/hmi/cli_exec_test.sh $(BUILD) config/hmi.example.json

.PHONY: cli-exec
