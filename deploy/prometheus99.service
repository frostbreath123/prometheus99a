# systemd unit for the Prometheus99 HMI on Raspberry Pi OS Lite / Debian.
#
# Install (as root, paths are the defaults used below). The service user is
# "prometheus". The configuration, its signature and its key are owned by root
# and only READ by the service, so a compromised service cannot rewrite what it
# will accept. The directory /etc/prometheus99 must not be writable by the
# service either, or it could replace the files by renaming over them.
#   useradd --system --no-create-home --groups video,input prometheus
#   install -m 0755 build-linux/prometheus99 /usr/local/bin/prometheus99
#   install -m 0755 build-linux/p99_user /usr/local/bin/p99_user   # offline user tool
#   install -m 0755 build-linux/p99_sign /usr/local/bin/p99_sign   # offline signing tool
#   install -d -o root -g root -m 0755 /etc/prometheus99
#   install -d -o prometheus -g prometheus -m 0750 /var/lib/prometheus99
#   install -d -o prometheus -g prometheus -m 0750 /var/spool/prometheus99   # requests for p99_cfg (see prometheus99-config.service)
#   install -m 0644 -o root -g root config/hmi.example.json /etc/prometheus99/hmi.json   # edit plc.host AND plc.allowed_hosts
#   p99_sign keygen --key /etc/prometheus99/config.key
#   chown root:prometheus /etc/prometheus99/config.key && chmod 0440 /etc/prometheus99/config.key
#   p99_sign sign --config /etc/prometheus99/hmi.json --key /etc/prometheus99/config.key
#   chown root:root /etc/prometheus99/hmi.json.sig && chmod 0644 /etc/prometheus99/hmi.json.sig
#   install -m 0644 deploy/prometheus99.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now prometheus99
# Every change to hmi.json must be signed again (p99_sign sign ...) and the
# service restarted. Without a valid signature the HMI starts in safe mode: a
# banner on the screen, no PLC connection, writes off.
#
# Status: written and statically checked only (see docs/LINUX_VALIDATION.md).
# It has not been run under real systemd, nor on a Raspberry Pi.
#
# Liveness: the process sends READY=1 after its first frame and WATCHDOG=1
# every WatchdogSec/2, but only while the comms and supervisor threads are
# also advancing. A stuck process is killed and restarted by systemd.

[Unit]
Description=Prometheus99 HMI runtime
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
User=prometheus
Group=prometheus
SupplementaryGroups=video input
# Roles come from logging in on the screen. The process starts as viewer (no
# acknowledgements, no writes) until someone logs in. The production build
# refuses --role (exit status 2), so a role cannot be set from this unit. The
# user file is created by the first-boot screen or with p99_user, owned by the
# service user, mode 0600; a file that group or others can write is refused.
ExecStart=/usr/local/bin/prometheus99 --config /etc/prometheus99/hmi.json \
    --audit /var/lib/prometheus99/audit.log --alarms /var/lib/prometheus99/alarms.bin \
    --users /var/lib/prometheus99/users.bin \
    --config-key /etc/prometheus99/config.key --config-state /var/lib/prometheus99/config.serial \
    --spool /var/spool/prometheus99 \
    --fb /dev/fb0 --touch /dev/input/event0
Restart=on-failure
RestartSec=2
# The runtime sends a ping every 5 s. A worker thread may legitimately be
# blocked in a bounded Modbus call for several seconds; 10 s leaves margin.
WatchdogSec=10
TimeoutStartSec=30
TimeoutStopSec=15
# Exit status 2 means "framebuffer cannot be opened". The restart delay and the
# start limit in [Unit] stop a tight restart loop until the display exists.

# Hardening (docs section 10). The HMI needs the framebuffer and evdev nodes only.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Everything the HMI writes is in this directory: audit.log and audit.log.1 to
# .4, alarms.bin, alarms.bin.journal and alarms.bin.journal.1 to .4, the user
# file and the config serial (docs/STORAGE.md). If a SystemCallFilter is added
# later it must still allow adjtimex (read only), which gives the clock state
# written to every audit line.
ReadWritePaths=/var/lib/prometheus99 /var/spool/prometheus99
DeviceAllow=/dev/fb0 rw
DeviceAllow=char-input rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
